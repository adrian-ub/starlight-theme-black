{
  "name": "starlight-theme-black-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "description": "Starlight theme inspired by Shadcn docs",
  "author": "adrian-ub",
  "license": "MIT",
  "homepage": "https://github.com/adrian-ub/starlight-theme-black",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrian-ub/starlight-theme-black.git"
  },
  "bugs": "https://github.com/adrian-ub/starlight-theme-black/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "release": "bumpp && npm publish",
    "prepare": "simple-git-hooks",
    "docs": "nr -C docs dev",
    "docs:build": "nr -C docs build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "astro-eslint-parser": "^3.2.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.6.1",
    "prettier-plugin-astro": "^1.1.2",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ]
}
